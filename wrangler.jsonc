// The game and its internal tool pages are one static Vite build; `bunx wrangler deploy` serves dist/
// at https://rts.ivryb.com (custom domain) and the old dune77.ivrybn.workers.dev address.
// GitHub Actions deploys every push to main (.github/workflows/deploy.yml).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dune77",
  "account_id": "8a66125b4def6052f9afa0b466b8c04a",
  "compatibility_date": "2026-08-11",
  "workers_dev": true,
  "routes": [{ "pattern": "rts.ivryb.com", "custom_domain": true }],
  "assets": { "directory": "./dist" }
}
