{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "types": ["vite/client"],
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "src",
    "tools/ui-review/review.ts",
    "tools/ui-review/scene.ts",
    "tools/ui-review/states.ts",
    "prototypes/terrain-playground/**/*.ts",
    "prototypes/procedural-buildings/**/*.ts"
  ]
}
